# ============================================================
# 投资小工具 · .gitignore
# 本文件确保「绝不」把下面这些传上 GitHub
# ============================================================

# ---- 自带 Python 运行时（约 492MB，太大且别人用 pip 装即可）----
runtime/

# ---- 个人数据 / 用户上传的年报 PDF 与提取缓存（私人，且大）----
qa_uploads/
reports/

# ---- 密钥与本地配置（含真实 API key，泄露危险，绝不能传）----
config.json

# ---- 数据库 / 各类缓存（都可再生成）----
*.db
__pycache__/
*.pyc
fin_cache.db
invest.db
peers_cache.json
valuation_cache.json
stock_cache.json
hk_stock_cache.json
qa_usage.json

# ---- 日志 ----
*.log
app_test.log
run.log

# ---- 操作系统 / 编辑器临时文件 ----
.DS_Store
Thumbs.db
*.swp
